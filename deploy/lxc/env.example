# /etc/pihole-rbac/env: the bootstrap settings and the master key, read by pihole-rbac.service (EnvironmentFile=).
# install.sh writes it from this template on the first install, with a new master key, and never changes it again.
# Owner root, group pihole-rbac, mode 0640. Restart the service after changing it: sudo systemctl restart pihole-rbac
#
# One KEY=value per line, without quotes.

PIHOLE_RBAC_LISTEN=:8080
PIHOLE_RBAC_DATA_DIR=/var/lib/pihole-rbac
PIHOLE_RBAC_LOG_DIR=/var/log/pihole-rbac
PIHOLE_RBAC_LOG_RETENTION_DAYS=30
PIHOLE_RBAC_LOG_LEVEL=info

# The reverse proxy's address (CIDRs or single addresses, comma-separated), so its X-Forwarded-For and
# X-Forwarded-Proto are believed. Keep it narrow: anything listed here can claim any client address.
#PIHOLE_RBAC_TRUSTED_PROXIES=192.168.1.10

# auto (Secure cookies when the proxy says the request was HTTPS), true or false.
PIHOLE_RBAC_COOKIE_SECURE=auto

# The master key: encrypts the Pi-hole passwords, the LDAP bind password and the notification secrets stored in the
# database. Keep a copy somewhere safe: without it those stored secrets can't be read. To change it, use
# `pihole-rbac rotate-key` (see `pihole-rbac help`).
PIHOLE_RBAC_SECRET_KEY=@SECRET_KEY@

# Optional: an internal CA bundle for LDAPS.
#PIHOLE_RBAC_LDAP_CA_FILE=/etc/pihole-rbac/ldap-ca.pem

# Optional: turn off the daily check for a new release (air-gapped installs).
#PIHOLE_RBAC_UPDATE_CHECK=false

# Optional overrides, normally unnecessary because passwords are entered in the app and stored encrypted. A file in
# /etc/pihole-rbac/secrets (group pihole-rbac, mode 0640) is re-read by "Reload secrets" without a restart.
#PIHOLE_RBAC_INSTANCE_PIHOLE1_PASSWORD_FILE=/etc/pihole-rbac/secrets/pihole1_password
#PIHOLE_RBAC_LDAP_BIND_PASSWORD_FILE=/etc/pihole-rbac/secrets/ldap_bind_password
